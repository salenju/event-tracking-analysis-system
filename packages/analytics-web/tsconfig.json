{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // 不含 vite.config.ts：该文件依赖 vite 的配置类型，
  // 而 vitest（track-server）会带入另一份 vite，两份类型混用会报 PluginOption 不兼容。
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"]
}
