# ---- 进程 ----
NODE_ENV=development
# all：单进程同时提供写入与查询；ingest：只提供 POST /api/track；api：只提供查询
START_MODE=all
HOST=0.0.0.0
PORT=8080

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=event_tracking

# 埋点写入池与查询池隔离：慢聚合查询不能占满写入连接
DB_POOL_INGEST=10
DB_POOL_QUERY=5
DB_QUERY_TIMEOUT_MS=5000

# ---- 接入与鉴权 ----
# appId → secret，同时是接入白名单。本地联调可把 SIGN_REQUIRED 设为 false
APP_SECRETS={"fylinking-storefront":"replace-me"}
SIGN_REQUIRED=true
# 请求时间与服务器时间允许的偏差（秒）
SIGN_WINDOW_SECONDS=300

# ---- 限流（每分钟）----
RATE_LIMIT_PER_IP=600
RATE_LIMIT_PER_APP=3000

# 允许跨域的站点，逗号分隔；* 表示不限制
CORS_ORIGINS=http://localhost:5173

# ---- 协议限制 ----
BODY_LIMIT_BYTES=262144
MAX_RECORDS_PER_BATCH=50
MAX_RECORD_BYTES=16384

# ---- 业务默认值 ----
# 写入 events.env 的默认值（SDK 未上报 env 时使用）
TRACK_ENV=prod
DEFAULT_TIMEZONE_OFFSET=+08:00
# 漏斗配置路径，缺省为 <package>/config/funnels.yaml
# FUNNELS_PATH=

# ---- 网关透传（客户端 IP / 国家 / 地区）----
# 服务端不做 GeoIP 反查，只读网关写好的请求头；按顺序取第一个命中的。
# 请按你们网关实际输出的头改成对应名称，例如 x-client-geo-country。
CLIENT_IP_HEADERS=x-real-ip,x-forwarded-for,x-client-ip
GEO_COUNTRY_HEADERS=cf-ipcountry,x-client-geo-country,x-geo-country,x-country-code,x-client-geo-loc,cloudfront-viewer-country
GEO_REGION_HEADERS=x-client-geo-region,x-geo-region,x-region

# ---- 看板登录（飞书开放平台「网页应用」）----
# 凭证只存在环境变量里，不落库；appId 与 secret 都非空时才启用飞书登录。
# FEISHU_REDIRECT_URI 必须与飞书后台「安全设置 → 重定向 URL」完全一致；
# 缺省为 ${WEB_ORIGIN}/api/auth/feishu/callback（dev 由 vite 代理到后端，生产建议填后端域名）。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# FEISHU_REDIRECT_URI=http://localhost:5174/api/auth/feishu/callback
# FEISHU_API_BASE=https://open.feishu.cn
# FEISHU_AUTH_BASE=https://passport.feishu.cn

# 登录成功后跳回的前端地址，必须与实际访问看板的地址一致（协议+域名+端口），
# 否则扫码登录的 postMessage 会被浏览器按 origin 丢弃。
WEB_ORIGIN=http://localhost:5174
SESSION_TTL_HOURS=168
# 直接授予管理员权限的飞书 open_id，逗号分隔；留空时库里没有管理员的第一个登录者自动成为管理员
ADMIN_BOOTSTRAP_OPEN_IDS=
# 查询接口是否强制登录：未配置时生产 true、其他环境 false
# AUTH_REQUIRED=true
# 本地调试登录（不经过飞书）：生产环境始终忽略
# DEV_LOGIN_ENABLED=true

LOG_LEVEL=info
