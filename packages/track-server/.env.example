# ---- 进程 ----
NODE_ENV=development
# all：单进程同时提供写入与查询；ingest：只提供 POST /api/track；api：只提供查询
START_MODE=all
HOST=0.0.0.0
PORT=8080

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=event_tracking

# 埋点写入池与查询池隔离：慢聚合查询不能占满写入连接
DB_POOL_INGEST=10
DB_POOL_QUERY=5
DB_QUERY_TIMEOUT_MS=5000

# ---- 接入与鉴权 ----
# appId → secret，同时是接入白名单。本地联调可把 SIGN_REQUIRED 设为 false
APP_SECRETS={"fylinking-storefront":"replace-me"}
SIGN_REQUIRED=true
# 请求时间与服务器时间允许的偏差（秒）
SIGN_WINDOW_SECONDS=300

# ---- 限流（每分钟）----
RATE_LIMIT_PER_IP=600
RATE_LIMIT_PER_APP=3000

# 允许跨域的站点，逗号分隔；* 表示不限制
CORS_ORIGINS=http://localhost:5173

# ---- 协议限制 ----
BODY_LIMIT_BYTES=262144
MAX_RECORDS_PER_BATCH=50
MAX_RECORD_BYTES=16384

# ---- 业务默认值 ----
# 写入 events.env 的默认值（SDK 未上报 env 时使用）
TRACK_ENV=prod
DEFAULT_TIMEZONE_OFFSET=+08:00
# 漏斗配置路径，缺省为 <package>/config/funnels.yaml
# FUNNELS_PATH=

LOG_LEVEL=info
