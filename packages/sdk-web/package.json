{
  "name": "track-sdk",
  "version": "2.3.0",
  "description": "A powerful frontend analytics tracking SDK with performance monitoring, user behavior tracking, and error monitoring capabilities",
  "main": "track-sdk.js",
  "unpkg": "dist/track-sdk.min.js",
  "jsdelivr": "dist/track-sdk.min.js",
  "files": [
    "track-sdk.js",
    "dist/track-sdk.min.js",
    "README.md"
  ],
  "scripts": {
    "demo": "open example.html",
    "lint": "eslint track-sdk.js test",
    "test": "node --test test/tracker.test.js test/signature.test.js",
    "build": "mkdir -p dist && terser track-sdk.js -c passes=2 -m --comments '/^!/' -o dist/track-sdk.min.js",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "analytics",
    "tracking",
    "performance",
    "monitoring",
    "web-vitals",
    "inp",
    "error-tracking",
    "user-behavior",
    "frontend-sdk"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/track-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/track-sdk/issues"
  },
  "homepage": "https://github.com/your-username/track-sdk#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "eslint": "^8.0.0",
    "terser": "^5.51.4"
  }
}
